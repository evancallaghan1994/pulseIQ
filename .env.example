# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pulseiq
DB_USER=pulseiq_user
DB_PASSWORD=your_password
DATABASE_URL=postgresql://pulseiq_user:your_password@localhost:5432/pulseiq

# Anthropic
ANTHROPIC_API_KEY=your_key_here
CLAUDE_MODEL=claude-sonnet-4-6

# MLflow
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# ChromaDB
CHROMA_PERSIST_DIR=rag/chroma_store

# Airflow
AIRFLOW_HOME=/opt/airflow

# App
STREAMLIT_PORT=8501
